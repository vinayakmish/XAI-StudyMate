{
  "name": "xai-studymate-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:ai": "cd ../ai-service && python -m uvicorn app.main:app --port 5000",
    "start:backend": "cd ../backend && mvn spring-boot:run \"-Dspring-boot.run.profiles=dev\"",
    "start:frontend": "vite",
    "start": "concurrently -n AI,BACKEND,FRONTEND -c cyan,yellow,green \"npm run start:ai\" \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
